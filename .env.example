# ==============================================================================
# MCP Sentinel Mesh — Configuration Template
# NOTE: Do NOT store real secrets or production credentials in this file.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Security Policy Configuration
DENY_BY_DEFAULT=true
MAX_ARGUMENT_PAYLOAD_BYTES=1048576
MAX_RATE_PER_MINUTE_DEFAULT=60
REPLAY_NONCE_TTL_SECONDS=300

# Cryptographic Audit Ledger
AUDIT_INTEGRITY_CHECK_ON_STARTUP=true
AUDIT_STORAGE_PATH=data/audit_ledger.db

# Downstream Adapter Timeouts
MCP_DEFAULT_TIMEOUT_SECONDS=5.0
ALLOW_UNAUTHENTICATED_LOCAL_TESTING=true

# Optional Redis Cache (For distributed sliding-window rate limiting)
REDIS_URL=redis://localhost:6379/0
